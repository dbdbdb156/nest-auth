{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug NestJS App",
        "skipFiles": ["<node_internals>/**"],
        "program": "${workspaceFolder}/src/main.ts",
        "runtimeArgs": ["--nolazy", "-r", "ts-node/register"],
        "envFile": "${workspaceFolder}/.env",
        "autoAttachChildProcesses": true
      }
    ]
  }
  